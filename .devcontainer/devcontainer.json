{
  "name": "Pechincha Pronta (Python 3.11)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "Inicio.py"] },
    "vscode": { "extensions": ["ms-python.python", "ms-python.vscode-pylance"] }
  },
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt && echo '✅ Dependências instaladas'",
  "postAttachCommand": { "server": "streamlit run Inicio.py" },
  "portsAttributes": { "8501": { "label": "Aplicativo", "onAutoForward": "openPreview" } },
  "forwardPorts": [8501]
}
